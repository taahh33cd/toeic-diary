# Secrets are managed via Firebase Secret Manager (firebase functions:secrets:set)
# Do not add VAPID_* keys here — they conflict with Secret Manager declarations

# Web push is DISPATCHED to the Vercel Node runtime: pushes sent directly from
# Cloud Functions reach the service worker but iOS does not present them as a
# banner. Vercel-sent pushes present correctly. GCF triggers RTDB events and
# delegates the actual send to this endpoint.
PUSH_DISPATCH_URL=https://toeic-dictation-diary.vercel.app/api/push/dispatch
