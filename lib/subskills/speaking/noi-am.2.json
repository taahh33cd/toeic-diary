      "exercises": [
        { "id": "s5_t2_h1", "type": "multiple_choice", "instruction": "Khi một từ kết thúc bằng Nguyên âm và từ tiếp theo cũng bắt đầu bằng Nguyên âm, người bản xứ thường chèn thêm âm /w/ hoặc /j/ để nối. Khi nào chèn /w/?", "tts_text": "", "options": [ {"id": "A", "text": "Khi từ đầu kết thúc bằng âm chu môi (o, u, oo)"}, {"id": "B", "text": "Khi từ đầu kết thúc bằng âm bè ngang (i, e)"}, {"id": "C", "text": "Luôn luôn chèn /w/"}, {"id": "D", "text": "Tùy hứng"} ], "correct_answers": ["A"], "explanation": "Khẩu hình chu tròn chuyển sang mở miệng sinh ra /w/." },
        { "id": "s5_t2_h2", "type": "multiple_choice", "instruction": "Cụm 'two apples' được chèn thêm âm gì để nối?", "tts_text": "two apples", "options": [ {"id": "A", "text": "Âm /w/ (two - w - apples)"}, {"id": "B", "text": "Âm /j/ (two - y - apples)"}, {"id": "C", "text": "Âm /r/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["A"], "explanation": "two kết thúc bằng /uː/ chu môi -> chèn /w/." },
        { "id": "s5_t2_h3", "type": "multiple_choice", "instruction": "Cụm 'you and I' được chèn thêm âm gì để nối?", "tts_text": "you and I", "options": [ {"id": "A", "text": "Âm /j/ (you - y - and)"}, {"id": "B", "text": "Âm /w/ (you - w - and)"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /d/"} ], "correct_answers": ["B"], "explanation": "you kết thúc bằng /uː/ -> chèn /w/." },
        { "id": "s5_t2_h4", "type": "multiple_choice", "instruction": "Cụm 'be on time' được chèn thêm âm gì để nối giữa 'be' và 'on'?", "tts_text": "be on time", "options": [ {"id": "A", "text": "Âm /j/ (be - y - on)"}, {"id": "B", "text": "Âm /w/"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /s/"} ], "correct_answers": ["A"], "explanation": "be kết thúc bằng /iː/ bè miệng -> chèn /j/." },
        { "id": "s5_t2_h5", "type": "multiple_choice", "instruction": "Cụm 'lay it down' được chèn thêm âm gì để nối giữa 'lay' và 'it'?", "tts_text": "lay it down", "options": [ {"id": "A", "text": "Âm /w/"}, {"id": "B", "text": "Âm /j/ (lay - y - it)"}, {"id": "C", "text": "Âm /t/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["B"], "explanation": "lay kết thúc bằng /eɪ/ -> chèn /j/." },
        { "id": "s5_t2_h6", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng một Phụ âm và từ sau bắt đầu bằng CHÍNH PHỤ ÂM ĐÓ (Geminates), ta nên đọc thế nào?", "tts_text": "good dog", "options": [ {"id": "A", "text": "Bị câm hoàn toàn"}, {"id": "B", "text": "Đọc thành một phụ âm khác"}, {"id": "C", "text": "Giữ khẩu hình phụ âm đó lâu hơn một chút (Chỉ bật 1 lần)"}, {"id": "D", "text": "Đọc tách rời, bật 2 lần" } ], "correct_answers": ["C"], "explanation": "Geminates." },
        { "id": "s5_t2_h7", "type": "multiple_choice", "instruction": "Cụm 'hot tea' được nối âm như thế nào?", "tts_text": "hot tea", "options": [ {"id": "A", "text": "ho - tea (giữ âm t ở giữa lâu hơn 1 chút)"}, {"id": "B", "text": "hot - t - tea (bật 2 lần)"}, {"id": "C", "text": "ho - tea (đọc nhanh)"}, {"id": "D", "text": "hot - a - tea"} ], "correct_answers": ["A"], "explanation": "Giữ khẩu hình âm t một nhịp rồi bật." },
        { "id": "s5_t2_h8", "type": "multiple_choice", "instruction": "Trong Tiếng Anh-Anh, cụm 'far away' có hiện tượng nối âm gì?", "tts_text": "far away", "options": [ {"id": "A", "text": "Linking R"}, {"id": "B", "text": "Flap T"}, {"id": "C", "text": "Chèn âm /w/"}, {"id": "D", "text": "Bị câm"} ], "correct_answers": ["A"], "explanation": "Âm /r/ xuất hiện để nối." },
        { "id": "s5_t2_h9", "type": "multiple_choice", "instruction": "Cụm 'could you' biến âm (Assimilation) thành gì?", "tts_text": "could you", "options": [ {"id": "A", "text": "ku - dʒu (kud-ju)"}, {"id": "B", "text": "ku - du"}, {"id": "C", "text": "could - you"}, {"id": "D", "text": "ku - dzu"} ], "correct_answers": ["A"], "explanation": "d + j -> dʒ." },
