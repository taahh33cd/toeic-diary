        { "id": "s5_t2_e19", "type": "essay_typing", "instruction": "Gõ lại cụm 2 từ có chứa NỐI ÂM trong câu sau.", "content": "Turn off the TV.", "tts_text": "Turn off the TV.", "options": [], "correct_answers": ["Turn off", "turn off", "turnoff"], "explanation": "Turn off." },
        { "id": "s5_t2_e20", "type": "essay_typing", "instruction": "Gõ lại cụm 2 từ có chứa NỐI ÂM trong câu sau.", "content": "Come over here.", "tts_text": "Come over here.", "options": [], "correct_answers": ["Come over", "come over", "comeover"], "explanation": "Come over ('e' câm, nối m với o)." },
