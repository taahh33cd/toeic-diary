      "exercises": [
        { "id": "s5_t2_e1", "type": "multiple_choice", "instruction": "Cụm 'pick it' được nối âm như thế nào?", "tts_text": "pick it", "options": [ {"id": "A", "text": "pic - kit (pic-kit)"}, {"id": "B", "text": "pick - it (không nối)"}, {"id": "C", "text": "pi - ckit"}, {"id": "D", "text": "pic - k - it"} ], "correct_answers": ["A"], "explanation": "Phụ âm /k/ ở cuối 'pick' nối với nguyên âm /ɪ/ ở đầu 'it' tạo thành /pɪ - kɪt/." },
        { "id": "s5_t2_e2", "type": "multiple_choice", "instruction": "Cụm 'keep it' được nối âm như thế nào?", "tts_text": "keep it", "options": [ {"id": "A", "text": "kee - pit (kee-pit)"}, {"id": "B", "text": "keep - it"}, {"id": "C", "text": "kee - p - it"}, {"id": "D", "text": "ke - epit"} ], "correct_answers": ["A"], "explanation": "Phụ âm /p/ ở cuối nối với nguyên âm /ɪ/ tạo thành /kiː - pɪt/." },
        { "id": "s5_t2_e3", "type": "multiple_choice", "instruction": "Cụm 'make it' được nối âm như thế nào?", "tts_text": "make it", "options": [ {"id": "A", "text": "make - it"}, {"id": "B", "text": "ma - kit (ma-kit)"}, {"id": "C", "text": "ma - ke - it"}, {"id": "D", "text": "mak - it"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' cuối 'make' bị câm. Âm thực sự cuối cùng là /k/ nối với /ɪ/ tạo thành /meɪ - kɪt/." },
        { "id": "s5_t2_e4", "type": "multiple_choice", "instruction": "Cụm 'leave it' được nối âm như thế nào?", "tts_text": "leave it", "options": [ {"id": "A", "text": "leave - it"}, {"id": "B", "text": "lea - vit (lea-vit)"}, {"id": "C", "text": "leav - it"}, {"id": "D", "text": "lea - ve - it"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' ở cuối bị câm, âm /v/ nối với /ɪ/ tạo thành /liː - vɪt/." },
        { "id": "s5_t2_e5", "type": "multiple_choice", "instruction": "Cụm 'read on' được nối âm như thế nào?", "tts_text": "read on", "options": [ {"id": "A", "text": "rea - don (rea-don)"}, {"id": "B", "text": "read - on"}, {"id": "C", "text": "rea - d - on"}, {"id": "D", "text": "re - adon"} ], "correct_answers": ["A"], "explanation": "Âm /d/ nối với âm /ɒ/ tạo thành /riː - dɒn/." },
        { "id": "s5_t2_e6", "type": "multiple_choice", "instruction": "Cụm 'run in' được nối âm như thế nào?", "tts_text": "run in", "options": [ {"id": "A", "text": "run - in"}, {"id": "B", "text": "ru - nin"}, {"id": "C", "text": "ru - nin (ru-nin)"}, {"id": "D", "text": "r - unin"} ], "correct_answers": ["C"], "explanation": "Âm /n/ nối với /ɪ/ tạo thành /rʌ - nɪn/." },
        { "id": "s5_t2_e7", "type": "multiple_choice", "instruction": "Cụm 'sleep on' được nối âm như thế nào?", "tts_text": "sleep on", "options": [ {"id": "A", "text": "slee - pon (slee-pon)"}, {"id": "B", "text": "sleep - on"}, {"id": "C", "text": "sl - eepon"}, {"id": "D", "text": "slee - p - on"} ], "correct_answers": ["A"], "explanation": "Âm /p/ nối với âm /ɒ/ tạo thành /sliː - pɒn/." },
        { "id": "s5_t2_e8", "type": "multiple_choice", "instruction": "Cụm 'watch it' được nối âm như thế nào?", "tts_text": "watch it", "options": [ {"id": "A", "text": "watch - it"}, {"id": "B", "text": "wa - tchi - t"}, {"id": "C", "text": "wa - tchit (wa-tchit)"}, {"id": "D", "text": "wat - chit"} ], "correct_answers": ["C"], "explanation": "Âm /tʃ/ nối với /ɪ/ tạo thành /wɒ - tʃɪt/." },
        { "id": "s5_t2_e9", "type": "multiple_choice", "instruction": "Cụm 'sit up' được nối âm như thế nào?", "tts_text": "sit up", "options": [ {"id": "A", "text": "si - tup (si-tup)"}, {"id": "B", "text": "sit - up"}, {"id": "C", "text": "si - t - up"}, {"id": "D", "text": "s - itup"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với /ʌ/ tạo thành /sɪ - tʌp/." },
        { "id": "s5_t2_e10", "type": "multiple_choice", "instruction": "Cụm 'look in' được nối âm như thế nào?", "tts_text": "look in", "options": [ {"id": "A", "text": "look - in"}, {"id": "B", "text": "loo - k - in"}, {"id": "C", "text": "loo - kin (loo-kin)"}, {"id": "D", "text": "lo - okin"} ], "correct_answers": ["C"], "explanation": "Âm /k/ nối với /ɪ/ tạo thành /lʊ - kɪn/." },
        { "id": "s5_t2_e11", "type": "essay_typing", "instruction": "Gõ lại TỪ tạo ra nối âm trong cụm sau (viết liền từ trước và từ sau, ví dụ: lookat).", "content": "grab it", "tts_text": "grab it", "options": [], "correct_answers": ["grabit", "Grabit"], "explanation": "grabit." },
