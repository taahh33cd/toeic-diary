        { "id": "s5_t2_m25", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm chứa Flap T trong câu sau.", "content": "It is a hot evening.", "tts_text": "It is a hot evening.", "options": [], "correct_answers": ["It is", "hot evening", "It is, hot evening", "itis", "hotevening"], "explanation": "It + is, hot + evening." }
