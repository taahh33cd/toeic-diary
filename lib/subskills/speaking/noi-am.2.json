    {
      "level": "Medium",
      "exercises": [
        { "id": "s5_t2_m1", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng đuôi '-ed' (được phát âm là /t/) đứng trước một nguyên âm, điều gì xảy ra?", "tts_text": "He washed it.", "options": [ {"id": "A", "text": "Âm /t/ bị câm luôn"}, {"id": "B", "text": "Âm /t/ nối liền sang nguyên âm tiếp theo"}, {"id": "C", "text": "Ngắt nghỉ rõ ràng giữa 2 từ"}, {"id": "D", "text": "Đổi thành âm /d/"} ], "correct_answers": ["B"], "explanation": "Ví dụ 'washed it' sẽ được đọc là /wɒʃ - tɪt/." },
        { "id": "s5_t2_m2", "type": "multiple_choice", "instruction": "Trong câu 'She watched a movie.', có mấy chỗ nối âm chính?", "tts_text": "She watched a movie.", "options": [ {"id": "A", "text": "3 chỗ"}, {"id": "B", "text": "1 chỗ"}, {"id": "C", "text": "2 chỗ"}, {"id": "D", "text": "Không có chỗ nào"} ], "correct_answers": ["B"], "explanation": "Có 1 chỗ: watched + a (ed đọc là /t/ nối với a -> /wɒtʃ - tə/)." },
        { "id": "s5_t2_m3", "type": "multiple_choice", "instruction": "Cụm 'stayed up' nối âm như thế nào?", "tts_text": "stayed up", "options": [ {"id": "A", "text": "stay - dup"}, {"id": "B", "text": "stayed - up"}, {"id": "C", "text": "sta - yedup"}, {"id": "D", "text": "stay - e - dup"} ], "correct_answers": ["A"], "explanation": "'stayed' có âm cuối là /d/ -> /steɪ - dʌp/." },
        { "id": "s5_t2_m4", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng '-s' (được phát âm là /s/) đứng trước nguyên âm, điều gì xảy ra?", "tts_text": "She works a lot.", "options": [ {"id": "A", "text": "Đổi thành âm /z/"}, {"id": "B", "text": "Bị câm"}, {"id": "C", "text": "Ngắt nghỉ"}, {"id": "D", "text": "Âm /s/ nối liền sang nguyên âm tiếp theo"} ], "correct_answers": ["D"], "explanation": "'works a' đọc là /wɜːk - sə/." },
        { "id": "s5_t2_m5", "type": "multiple_choice", "instruction": "Cụm 'cats are' nối âm như thế nào?", "tts_text": "cats are", "options": [ {"id": "A", "text": "cat - sare"}, {"id": "B", "text": "cat - zare"}, {"id": "C", "text": "cats - are"}, {"id": "D", "text": "ca - tsare"} ], "correct_answers": ["A"], "explanation": "'cats' kết thúc bằng /s/ -> /kæt - sɑːr/." },
        { "id": "s5_t2_m6", "type": "multiple_choice", "instruction": "Trong câu 'I caught a cold.', chỗ nào chứa nối âm?", "tts_text": "I caught a cold.", "options": [ {"id": "A", "text": "caught a"}, {"id": "B", "text": "caught a, a cold"}, {"id": "C", "text": "I caught"}, {"id": "D", "text": "a cold"} ], "correct_answers": ["A"], "explanation": "caught a (/kɔː - tə/)." },
        { "id": "s5_t2_m7", "type": "multiple_choice", "instruction": "Cụm 'more apples' nối âm như thế nào?", "tts_text": "more apples", "options": [ {"id": "A", "text": "mo - rapples"}, {"id": "B", "text": "more - apples"}, {"id": "C", "text": "morea - pples"}, {"id": "D", "text": "mo - r - apples"} ], "correct_answers": ["A"], "explanation": "Âm /r/ kết nối giữa 2 từ: /mɔː - ˈræplz/." },
        { "id": "s5_t2_m8", "type": "multiple_choice", "instruction": "Trong tiếng Anh-Mỹ, âm /t/ nằm giữa 2 nguyên âm (ví dụ: later) thường đọc thành gì?", "tts_text": "later", "options": [ {"id": "A", "text": "Âm /s/"}, {"id": "B", "text": "Âm /d/ (Flap T)"}, {"id": "C", "text": "Âm /k/"}, {"id": "D", "text": "Âm /th/"} ], "correct_answers": ["B"], "explanation": "Flap T." },
        { "id": "s5_t2_m9", "type": "multiple_choice", "instruction": "Cụm 'get it' trong tiếng Anh-Mỹ thường được đọc là gì do hiện tượng Flap T?", "tts_text": "get it", "options": [ {"id": "A", "text": "ge - dit"}, {"id": "B", "text": "ge - tit"}, {"id": "C", "text": "get - it"}, {"id": "D", "text": "ge - sit"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối sang và biến thành âm /d/ nhẹ: /ge - dɪt/." },
        { "id": "s5_t2_m10", "type": "multiple_choice", "instruction": "Cụm 'cut it' trong tiếng Anh-Mỹ thường được đọc là gì?", "tts_text": "cut it", "options": [ {"id": "A", "text": "cu - sit"}, {"id": "B", "text": "cu - tit"}, {"id": "C", "text": "cu - dit"}, {"id": "D", "text": "cut - it"} ], "correct_answers": ["C"], "explanation": "Flap T: /kʌ - dɪt/." },
        { "id": "s5_t2_m11", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "I looked around the room.", "tts_text": "I looked around the room.", "options": [], "correct_answers": ["looked around", "lookedaround"], "explanation": "looked (ed=t) + around." },
        { "id": "s5_t2_m12", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He cleaned it yesterday.", "tts_text": "He cleaned it yesterday.", "options": [], "correct_answers": ["cleaned it", "cleanedit"], "explanation": "cleaned (ed=d) + it." },
        { "id": "s5_t2_m13", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "We threw it away.", "tts_text": "We threw it away.", "options": [], "correct_answers": ["threw it", "it away", "threw it, it away", "threwit", "itaway"], "explanation": "threw + it (chèn w), it + away." },
        { "id": "s5_t2_m14", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "She watched an old movie.", "tts_text": "She watched an old movie.", "options": [], "correct_answers": ["watched an", "an old", "watched an, an old", "watchedan", "anold"], "explanation": "watched (ed=t) + an, an + old." },
        { "id": "s5_t2_m15", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "They opened a box.", "tts_text": "They opened a box.", "options": [], "correct_answers": ["opened a", "openeda"], "explanation": "opened (ed=d) + a." },
        { "id": "s5_t2_m16", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He loves apples.", "tts_text": "He loves apples.", "options": [], "correct_answers": ["loves apples", "lovesapples"], "explanation": "loves (s=z) + apples." },
        { "id": "s5_t2_m17", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "She wants a pen.", "tts_text": "She wants a pen.", "options": [], "correct_answers": ["wants a", "wantsa"], "explanation": "wants (s=s) + a." },
        { "id": "s5_t2_m18", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "The bags are heavy.", "tts_text": "The bags are heavy.", "options": [], "correct_answers": ["bags are", "bagsare"], "explanation": "bags (s=z) + are." },
        { "id": "s5_t2_m19", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He watches animals.", "tts_text": "He watches animals.", "options": [], "correct_answers": ["watches animals", "watchesanimals"], "explanation": "watches (es=ɪz) + animals." },
        { "id": "s5_t2_m20", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "It takes a lot of time.", "tts_text": "It takes a lot of time.", "options": [], "correct_answers": ["takes a", "a lot", "lot of", "takes a, a lot, lot of"], "explanation": "takes a, a lot, lot of." },
        { "id": "s5_t2_m21", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm chứa Flap T trong câu sau.", "content": "I got a new job.", "tts_text": "I got a new job.", "options": [], "correct_answers": ["got a", "gota"], "explanation": "got + a -> /gɒ - də/." },
