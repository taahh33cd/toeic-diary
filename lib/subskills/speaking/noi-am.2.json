        { "id": "s5_t2_e14", "type": "essay_typing", "instruction": "Gõ lại hiện tượng nối âm (viết liền 2 từ).", "content": "catch it", "tts_text": "catch it", "options": [], "correct_answers": ["catchit", "Catchit"], "explanation": "catchit." },
        { "id": "s5_t2_e15", "type": "essay_typing", "instruction": "Gõ lại hiện tượng nối âm (viết liền 2 từ).", "content": "drop it", "tts_text": "drop it", "options": [], "correct_answers": ["dropit", "Dropit"], "explanation": "dropit." },
        { "id": "s5_t2_e16", "type": "essay_typing", "instruction": "Gõ lại cụm 2 từ có chứa NỐI ÂM trong câu sau.", "content": "It is an open book.", "tts_text": "It is an open book.", "options": [], "correct_answers": ["is an", "an open", "is an, an open", "isan", "anopen", "It is", "It is, is an, an open"], "explanation": "It is (t+i), is an (z+a), an open (n+o)." },
        { "id": "s5_t2_e17", "type": "essay_typing", "instruction": "Gõ lại cụm 2 từ có chứa NỐI ÂM trong câu sau.", "content": "Look around the room.", "tts_text": "Look around the room.", "options": [], "correct_answers": ["Look around", "look around", "lookaround"], "explanation": "Look around." },
