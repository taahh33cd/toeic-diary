        { "id": "s5_t4_e6", "type": "multiple_choice", "instruction": "Cụm 'run out' được nối âm như thế nào?", "tts_text": "run out", "options": [ {"id": "A", "text": "run - out"}, {"id": "B", "text": "ru - nout"}, {"id": "C", "text": "ru - nout (ru-nout)"}, {"id": "D", "text": "r - unout"} ], "correct_answers": ["C"], "explanation": "Âm /n/ nối với /aʊ/ tạo thành /rʌ - naʊt/." },
        { "id": "s5_t4_e7", "type": "multiple_choice", "instruction": "Cụm 'speak up' được nối âm như thế nào?", "tts_text": "speak up", "options": [ {"id": "A", "text": "spea - kup (spea-kup)"}, {"id": "B", "text": "speak - up"}, {"id": "C", "text": "sp - eakup"}, {"id": "D", "text": "spea - k - up"} ], "correct_answers": ["A"], "explanation": "Âm /k/ nối với âm /ʌ/ tạo thành /spiː - kʌp/." },
        { "id": "s5_t4_e8", "type": "multiple_choice", "instruction": "Cụm 'touch it' được nối âm như thế nào?", "tts_text": "touch it", "options": [ {"id": "A", "text": "touch - it"}, {"id": "B", "text": "tou - tchi - t"}, {"id": "C", "text": "tou - tchit (tou-tchit)"}, {"id": "D", "text": "tout - chit"} ], "correct_answers": ["C"], "explanation": "Âm /tʃ/ nối với /ɪ/ tạo thành /tʌ - tʃɪt/." },
        { "id": "s5_t4_e9", "type": "multiple_choice", "instruction": "Cụm 'let up' được nối âm như thế nào?", "tts_text": "let up", "options": [ {"id": "A", "text": "le - tup (le-tup)"}, {"id": "B", "text": "let - up"}, {"id": "C", "text": "le - t - up"}, {"id": "D", "text": "l - etup"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với /ʌ/ tạo thành /le - tʌp/." },
        { "id": "s5_t4_e10", "type": "multiple_choice", "instruction": "Cụm 'back out' được nối âm như thế nào?", "tts_text": "back out", "options": [ {"id": "A", "text": "back - out"}, {"id": "B", "text": "ba - c - kout"}, {"id": "C", "text": "ba - ckout (ba-ckout)"}, {"id": "D", "text": "bac - out"} ], "correct_answers": ["C"], "explanation": "Âm /k/ nối với /aʊ/ tạo thành /bæ - kaʊt/." },
