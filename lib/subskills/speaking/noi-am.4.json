        { "id": "s5_t4_e1", "type": "multiple_choice", "instruction": "Cụm 'save it' được nối âm như thế nào?", "tts_text": "save it", "options": [ {"id": "A", "text": "sa - vit (sa-vit)"}, {"id": "B", "text": "save - it (không nối)"}, {"id": "C", "text": "sa - ve - it"}, {"id": "D", "text": "sav - it"} ], "correct_answers": ["A"], "explanation": "Chữ 'e' cuối câm, phụ âm /v/ nối với /ɪ/ tạo thành /seɪ - vɪt/." },
        { "id": "s5_t4_e2", "type": "multiple_choice", "instruction": "Cụm 'look up' được nối âm như thế nào?", "tts_text": "look up", "options": [ {"id": "A", "text": "loo - kup (loo-kup)"}, {"id": "B", "text": "look - up"}, {"id": "C", "text": "loo - k - up"}, {"id": "D", "text": "lo - okup"} ], "correct_answers": ["A"], "explanation": "Phụ âm /k/ ở cuối nối với nguyên âm /ʌ/ tạo thành /lʊ - kʌp/." },
