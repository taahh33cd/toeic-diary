      "exercises": [
        { "id": "s5_t4_m1", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng đuôi '-ed' (được phát âm là /d/) đứng trước một nguyên âm, điều gì xảy ra?", "tts_text": "He cleaned it.", "options": [ {"id": "A", "text": "Âm /d/ bị câm luôn"}, {"id": "B", "text": "Âm /d/ nối liền sang nguyên âm tiếp theo"}, {"id": "C", "text": "Ngắt nghỉ rõ ràng giữa 2 từ"}, {"id": "D", "text": "Đổi thành âm /t/"} ], "correct_answers": ["B"], "explanation": "Ví dụ 'cleaned it' sẽ được đọc là /kliːn - dɪt/." },
        { "id": "s5_t4_m2", "type": "multiple_choice", "instruction": "Trong câu 'She finished it.', có mấy chỗ nối âm chính?", "tts_text": "She finished it.", "options": [ {"id": "A", "text": "3 chỗ"}, {"id": "B", "text": "1 chỗ"}, {"id": "C", "text": "2 chỗ"}, {"id": "D", "text": "Không có chỗ nào"} ], "correct_answers": ["B"], "explanation": "Có 1 chỗ: finished + it (ed đọc là /t/ nối với i -> /fɪnɪʃ - tɪt/)." },
        { "id": "s5_t4_m3", "type": "multiple_choice", "instruction": "Cụm 'slowed up' nối âm như thế nào?", "tts_text": "slowed up", "options": [ {"id": "A", "text": "slow - dup"}, {"id": "B", "text": "slowed - up"}, {"id": "C", "text": "slo - wedup"}, {"id": "D", "text": "slow - e - dup"} ], "correct_answers": ["A"], "explanation": "'slowed' có âm cuối là /d/ -> /sloʊ - dʌp/." },
        { "id": "s5_t4_m4", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng '-s' (được phát âm là /s/) đứng trước nguyên âm, điều gì xảy ra?", "tts_text": "She speaks a lot.", "options": [ {"id": "A", "text": "Đổi thành âm /z/"}, {"id": "B", "text": "Bị câm"}, {"id": "C", "text": "Ngắt nghỉ"}, {"id": "D", "text": "Âm /s/ nối liền sang nguyên âm tiếp theo"} ], "correct_answers": ["D"], "explanation": "'speaks a' đọc là /spiːk - sə/." },
        { "id": "s5_t4_m5", "type": "multiple_choice", "instruction": "Cụm 'boys eat' nối âm như thế nào?", "tts_text": "boys eat", "options": [ {"id": "A", "text": "boy - seat"}, {"id": "B", "text": "boy - zeat"}, {"id": "C", "text": "boys - eat"}, {"id": "D", "text": "bo - yzeat"} ], "correct_answers": ["B"], "explanation": "'boys' kết thúc bằng /z/ -> /bɔɪ - ziːt/." },
        { "id": "s5_t4_m6", "type": "multiple_choice", "instruction": "Trong câu 'He brought an orange.', chỗ nào chứa nối âm?", "tts_text": "He brought an orange.", "options": [ {"id": "A", "text": "brought an"}, {"id": "B", "text": "brought an, an orange"}, {"id": "C", "text": "He brought"}, {"id": "D", "text": "an orange"} ], "correct_answers": ["B"], "explanation": "brought an (/brɔː - tən/), an orange (/ə - nɒrɪndʒ/)." },
        { "id": "s5_t4_m7", "type": "multiple_choice", "instruction": "Cụm 'more ideas' nối âm như thế nào?", "tts_text": "more ideas", "options": [ {"id": "A", "text": "mo - rideas"}, {"id": "B", "text": "more - ideas"}, {"id": "C", "text": "morea - deas"}, {"id": "D", "text": "mo - r - ideas"} ], "correct_answers": ["A"], "explanation": "Âm /r/ kết nối: /mɔː - raɪˈdɪəz/." },
        { "id": "s5_t4_m8", "type": "multiple_choice", "instruction": "Trong tiếng Anh-Mỹ, âm /t/ nằm giữa 2 nguyên âm (ví dụ: better) thường đọc thành gì?", "tts_text": "better", "options": [ {"id": "A", "text": "Âm /s/"}, {"id": "B", "text": "Âm /d/ (Flap T)"}, {"id": "C", "text": "Âm /k/"}, {"id": "D", "text": "Âm /th/"} ], "correct_answers": ["B"], "explanation": "Flap T." },
        { "id": "s5_t4_m9", "type": "multiple_choice", "instruction": "Cụm 'let it' trong tiếng Anh-Mỹ thường được đọc là gì do hiện tượng Flap T?", "tts_text": "let it", "options": [ {"id": "A", "text": "le - dit"}, {"id": "B", "text": "le - tit"}, {"id": "C", "text": "let - it"}, {"id": "D", "text": "le - sit"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối sang và biến thành âm /d/ nhẹ: /le - dɪt/." },
        { "id": "s5_t4_m10", "type": "multiple_choice", "instruction": "Cụm 'set out' trong tiếng Anh-Mỹ thường được đọc là gì?", "tts_text": "set out", "options": [ {"id": "A", "text": "se - sout"}, {"id": "B", "text": "se - tout"}, {"id": "C", "text": "se - dout"}, {"id": "D", "text": "set - out"} ], "correct_answers": ["C"], "explanation": "Flap T: /se - daʊt/." },
