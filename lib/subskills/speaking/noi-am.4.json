        { "id": "s5_t4_e4", "type": "multiple_choice", "instruction": "Cụm 'live on' được nối âm như thế nào?", "tts_text": "live on", "options": [ {"id": "A", "text": "live - on"}, {"id": "B", "text": "li - von (li-von)"}, {"id": "C", "text": "liv - on"}, {"id": "D", "text": "li - ve - on"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' ở cuối bị câm, âm /v/ nối với /ɒ/ tạo thành /lɪ - vɒn/." },
