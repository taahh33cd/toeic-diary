        { "id": "s5_t5_e1", "type": "multiple_choice", "instruction": "Cụm 'love it' được nối âm như thế nào?", "tts_text": "love it", "options": [ {"id": "A", "text": "lo - vit (lo-vit)"}, {"id": "B", "text": "love - it (không nối)"}, {"id": "C", "text": "lo - ve - it"}, {"id": "D", "text": "lov - it"} ], "correct_answers": ["A"], "explanation": "Chữ 'e' cuối câm, phụ âm /v/ nối với /ɪ/ tạo thành /lʌ - vɪt/." },
        { "id": "s5_t5_e2", "type": "multiple_choice", "instruction": "Cụm 'wake up' được nối âm như thế nào?", "tts_text": "wake up", "options": [ {"id": "A", "text": "wa - kup (wa-kup)"}, {"id": "B", "text": "wake - up"}, {"id": "C", "text": "wa - k - up"}, {"id": "D", "text": "wak - up"} ], "correct_answers": ["A"], "explanation": "Phụ âm /k/ ở cuối nối với nguyên âm /ʌ/ tạo thành /weɪ - kʌp/." },
        { "id": "s5_t5_e3", "type": "multiple_choice", "instruction": "Cụm 'hide out' được nối âm như thế nào?", "tts_text": "hide out", "options": [ {"id": "A", "text": "hide - out"}, {"id": "B", "text": "hi - dout (hi-dout)"}, {"id": "C", "text": "hi - de - out"}, {"id": "D", "text": "hid - out"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' cuối 'hide' bị câm. Âm thực sự cuối cùng là /d/ nối với /aʊ/ tạo thành /haɪ - daʊt/." },
        { "id": "s5_t5_e4", "type": "multiple_choice", "instruction": "Cụm 'drive on' được nối âm như thế nào?", "tts_text": "drive on", "options": [ {"id": "A", "text": "drive - on"}, {"id": "B", "text": "dri - von (dri-von)"}, {"id": "C", "text": "driv - on"}, {"id": "D", "text": "dri - ve - on"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' ở cuối bị câm, âm /v/ nối với /ɒ/ tạo thành /draɪ - vɒn/." },
        { "id": "s5_t5_e5", "type": "multiple_choice", "instruction": "Cụm 'shut it' được nối âm như thế nào?", "tts_text": "shut it", "options": [ {"id": "A", "text": "shu - tit (shu-tit)"}, {"id": "B", "text": "shut - it"}, {"id": "C", "text": "shu - t - it"}, {"id": "D", "text": "sh - utit"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với âm /ɪ/ tạo thành /ʃʌ - tɪt/." },
        { "id": "s5_t5_e6", "type": "multiple_choice", "instruction": "Cụm 'clean out' được nối âm như thế nào?", "tts_text": "clean out", "options": [ {"id": "A", "text": "clean - out"}, {"id": "B", "text": "clea - nout (clea-nout)"}, {"id": "C", "text": "clea - nout"}, {"id": "D", "text": "cl - eanout"} ], "correct_answers": ["B"], "explanation": "Âm /n/ nối với /aʊ/ tạo thành /kliː - naʊt/." },
        { "id": "s5_t5_e7", "type": "multiple_choice", "instruction": "Cụm 'look up' được nối âm như thế nào?", "tts_text": "look up", "options": [ {"id": "A", "text": "loo - kup (loo-kup)"}, {"id": "B", "text": "look - up"}, {"id": "C", "text": "lo - okup"}, {"id": "D", "text": "loo - k - up"} ], "correct_answers": ["A"], "explanation": "Âm /k/ nối với âm /ʌ/ tạo thành /lʊ - kʌp/." },
        { "id": "s5_t5_e8", "type": "multiple_choice", "instruction": "Cụm 'match it' được nối âm như thế nào?", "tts_text": "match it", "options": [ {"id": "A", "text": "match - it"}, {"id": "B", "text": "ma - tchi - t"}, {"id": "C", "text": "ma - tchit (ma-tchit)"}, {"id": "D", "text": "mat - chit"} ], "correct_answers": ["C"], "explanation": "Âm /tʃ/ nối với /ɪ/ tạo thành /mæ - tʃɪt/." },
        { "id": "s5_t5_e9", "type": "multiple_choice", "instruction": "Cụm 'set up' được nối âm như thế nào?", "tts_text": "set up", "options": [ {"id": "A", "text": "se - tup (se-tup)"}, {"id": "B", "text": "set - up"}, {"id": "C", "text": "se - t - up"}, {"id": "D", "text": "s - etup"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với /ʌ/ tạo thành /se - tʌp/." },
        { "id": "s5_t5_e10", "type": "multiple_choice", "instruction": "Cụm 'check out' được nối âm như thế nào?", "tts_text": "check out", "options": [ {"id": "A", "text": "check - out"}, {"id": "B", "text": "che - c - kout"}, {"id": "C", "text": "che - ckout (che-ckout)"}, {"id": "D", "text": "chec - out"} ], "correct_answers": ["C"], "explanation": "Âm /k/ nối với /aʊ/ tạo thành /tʃe - kaʊt/." },
        { "id": "s5_t5_e11", "type": "essay_typing", "instruction": "Gõ lại TỪ tạo ra nối âm trong cụm sau.", "content": "take it", "tts_text": "take it", "options": [], "correct_answers": ["takeit", "Takeit"], "explanation": "takeit." },
