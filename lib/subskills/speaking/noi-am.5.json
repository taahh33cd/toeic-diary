        { "id": "s5_t5_e21", "type": "essay_typing", "instruction": "Gõ lại cụm 2 từ có chứa NỐI ÂM trong câu sau.", "content": "Need an idea.", "tts_text": "Need an idea.", "options": [], "correct_answers": ["Need an", "an idea", "Need an, an idea", "needan", "anidea"], "explanation": "Need an, an idea." },
