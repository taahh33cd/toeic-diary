    {
      "level": "Medium",
      "exercises": [
        { "id": "s5_t5_m1", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng đuôi '-ed' (được phát âm là /d/) đứng trước một nguyên âm, điều gì xảy ra?", "tts_text": "He saved it.", "options": [ {"id": "A", "text": "Âm /d/ bị câm luôn"}, {"id": "B", "text": "Âm /d/ nối liền sang nguyên âm tiếp theo"}, {"id": "C", "text": "Ngắt nghỉ rõ ràng giữa 2 từ"}, {"id": "D", "text": "Đổi thành âm /t/"} ], "correct_answers": ["B"], "explanation": "Ví dụ 'saved it' sẽ được đọc là /seɪv - dɪt/." },
        { "id": "s5_t5_m2", "type": "multiple_choice", "instruction": "Trong câu 'She watched it.', có mấy chỗ nối âm chính?", "tts_text": "She watched it.", "options": [ {"id": "A", "text": "3 chỗ"}, {"id": "B", "text": "1 chỗ"}, {"id": "C", "text": "2 chỗ"}, {"id": "D", "text": "Không có chỗ nào"} ], "correct_answers": ["B"], "explanation": "Có 1 chỗ: watched + it (ed đọc là /t/ nối với i -> /wɒtʃ - tɪt/)." },
        { "id": "s5_t5_m3", "type": "multiple_choice", "instruction": "Cụm 'showed out' nối âm như thế nào?", "tts_text": "showed out", "options": [ {"id": "A", "text": "show - dout"}, {"id": "B", "text": "showed - out"}, {"id": "C", "text": "sho - wedout"}, {"id": "D", "text": "show - e - dout"} ], "correct_answers": ["A"], "explanation": "'showed' có âm cuối là /d/ -> /ʃoʊ - daʊt/." },
        { "id": "s5_t5_m4", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng '-s' (được phát âm là /s/) đứng trước nguyên âm, điều gì xảy ra?", "tts_text": "She eats a lot.", "options": [ {"id": "A", "text": "Đổi thành âm /z/"}, {"id": "B", "text": "Bị câm"}, {"id": "C", "text": "Ngắt nghỉ"}, {"id": "D", "text": "Âm /s/ nối liền sang nguyên âm tiếp theo"} ], "correct_answers": ["D"], "explanation": "'eats a' đọc là /iːt - sə/." },
        { "id": "s5_t5_m5", "type": "multiple_choice", "instruction": "Cụm 'boys are' nối âm như thế nào?", "tts_text": "boys are", "options": [ {"id": "A", "text": "boy - sare"}, {"id": "B", "text": "boy - zare"}, {"id": "C", "text": "boys - are"}, {"id": "D", "text": "bo - yzare"} ], "correct_answers": ["B"], "explanation": "'boys' kết thúc bằng /z/ -> /bɔɪ - zɑːr/." },
        { "id": "s5_t5_m6", "type": "multiple_choice", "instruction": "Trong câu 'He brought an egg.', chỗ nào chứa nối âm?", "tts_text": "He brought an egg.", "options": [ {"id": "A", "text": "brought an"}, {"id": "B", "text": "brought an, an egg"}, {"id": "C", "text": "He brought"}, {"id": "D", "text": "an egg"} ], "correct_answers": ["B"], "explanation": "brought an (/brɔː - tən/), an egg (/ə - neg/)." },
        { "id": "s5_t5_m7", "type": "multiple_choice", "instruction": "Cụm 'four apples' nối âm như thế nào?", "tts_text": "four apples", "options": [ {"id": "A", "text": "fou - rapples"}, {"id": "B", "text": "four - apples"}, {"id": "C", "text": "foura - pples"}, {"id": "D", "text": "fou - r - apples"} ], "correct_answers": ["A"], "explanation": "Âm /r/ kết nối: /fɔː - ˈræplz/." },
        { "id": "s5_t5_m8", "type": "multiple_choice", "instruction": "Trong tiếng Anh-Mỹ, âm /t/ nằm giữa 2 nguyên âm (ví dụ: better) thường đọc thành gì?", "tts_text": "better", "options": [ {"id": "A", "text": "Âm /s/"}, {"id": "B", "text": "Âm /d/ (Flap T)"}, {"id": "C", "text": "Âm /k/"}, {"id": "D", "text": "Âm /th/"} ], "correct_answers": ["B"], "explanation": "Flap T." },
        { "id": "s5_t5_m9", "type": "multiple_choice", "instruction": "Cụm 'let it' trong tiếng Anh-Mỹ thường được đọc là gì do hiện tượng Flap T?", "tts_text": "let it", "options": [ {"id": "A", "text": "le - dit"}, {"id": "B", "text": "le - tit"}, {"id": "C", "text": "let - it"}, {"id": "D", "text": "le - sit"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối sang và biến thành âm /d/ nhẹ: /le - dɪt/." },
        { "id": "s5_t5_m10", "type": "multiple_choice", "instruction": "Cụm 'set it' trong tiếng Anh-Mỹ thường được đọc là gì?", "tts_text": "set it", "options": [ {"id": "A", "text": "se - sit"}, {"id": "B", "text": "se - tit"}, {"id": "C", "text": "se - dit"}, {"id": "D", "text": "set - it"} ], "correct_answers": ["C"], "explanation": "Flap T: /se - dɪt/." },
