        { "id": "s5_t5_m15", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "They opened a window.", "tts_text": "They opened a window.", "options": [], "correct_answers": ["opened a", "openeda"], "explanation": "opened (ed=d) + a." },
        { "id": "s5_t5_m16", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He hates apples.", "tts_text": "He hates apples.", "options": [], "correct_answers": ["hates apples", "hatesapples"], "explanation": "hates (s=s) + apples." },
        { "id": "s5_t5_m17", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "She likes an egg.", "tts_text": "She likes an egg.", "options": [], "correct_answers": ["likes an", "an egg", "likes an, an egg"], "explanation": "likes (s=s) + an, an + egg." },
        { "id": "s5_t5_m18", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "The bags are heavy.", "tts_text": "The bags are heavy.", "options": [], "correct_answers": ["bags are", "bagsare"], "explanation": "bags (s=z) + are." },
        { "id": "s5_t5_m19", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He washes insects.", "tts_text": "He washes insects.", "options": [], "correct_answers": ["washes insects", "washesinsects"], "explanation": "washes (es=ɪz) + insects." },
        { "id": "s5_t5_m20", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "It uses a lot of energy.", "tts_text": "It uses a lot of energy.", "options": [], "correct_answers": ["uses a", "a lot", "lot of", "of energy", "uses a, a lot, lot of, of energy"], "explanation": "uses a, a lot, lot of, of energy." },
