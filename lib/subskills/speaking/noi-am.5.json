      "exercises": [
        { "id": "s5_t5_h1", "type": "multiple_choice", "instruction": "Khi một từ kết thúc bằng Nguyên âm và từ tiếp theo cũng bắt đầu bằng Nguyên âm, người bản xứ thường chèn thêm âm /w/ hoặc /j/ để nối. Khi nào chèn /w/?", "tts_text": "", "options": [ {"id": "A", "text": "Khi từ đầu kết thúc bằng âm chu môi (o, u, oo)"}, {"id": "B", "text": "Khi từ đầu kết thúc bằng âm bè ngang (i, e, ei)"}, {"id": "C", "text": "Luôn luôn chèn /w/"}, {"id": "D", "text": "Tùy hứng"} ], "correct_answers": ["A"], "explanation": "Khẩu hình chu tròn chuyển sang mở miệng sinh ra /w/." },
        { "id": "s5_t5_h2", "type": "multiple_choice", "instruction": "Cụm 'do ants' được chèn thêm âm gì để nối?", "tts_text": "do ants", "options": [ {"id": "A", "text": "Âm /w/ (do - w - ants)"}, {"id": "B", "text": "Âm /j/ (do - y - ants)"}, {"id": "C", "text": "Âm /r/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["A"], "explanation": "do kết thúc bằng /uː/ chu môi -> chèn /w/." },
        { "id": "s5_t5_h3", "type": "multiple_choice", "instruction": "Cụm 'you and me' được chèn thêm âm gì để nối 'you' và 'and'?", "tts_text": "you and me", "options": [ {"id": "A", "text": "Âm /j/ (you - y - and)"}, {"id": "B", "text": "Âm /w/ (you - w - and)"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /d/"} ], "correct_answers": ["B"], "explanation": "you kết thúc bằng /uː/ -> chèn /w/." },
        { "id": "s5_t5_h4", "type": "multiple_choice", "instruction": "Cụm 'he is' được chèn thêm âm gì để nối?", "tts_text": "he is", "options": [ {"id": "A", "text": "Âm /j/ (he - y - is)"}, {"id": "B", "text": "Âm /w/"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /s/"} ], "correct_answers": ["A"], "explanation": "he kết thúc bằng /iː/ bè miệng -> chèn /j/." },
        { "id": "s5_t5_h5", "type": "multiple_choice", "instruction": "Cụm 'they are' được chèn thêm âm gì để nối?", "tts_text": "they are", "options": [ {"id": "A", "text": "Âm /w/"}, {"id": "B", "text": "Âm /j/ (they - y - are)"}, {"id": "C", "text": "Âm /t/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["B"], "explanation": "they kết thúc bằng /eɪ/ -> chèn /j/." },
        { "id": "s5_t5_h6", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng một Phụ âm và từ sau bắt đầu bằng CHÍNH PHỤ ÂM ĐÓ (Geminates), ta nên đọc thế nào?", "tts_text": "good day", "options": [ {"id": "A", "text": "Bị câm hoàn toàn"}, {"id": "B", "text": "Đọc thành một phụ âm khác"}, {"id": "C", "text": "Giữ khẩu hình phụ âm đó lâu hơn một chút (Chỉ bật 1 lần)"}, {"id": "D", "text": "Đọc tách rời, bật 2 lần" } ], "correct_answers": ["C"], "explanation": "Geminates." },
        { "id": "s5_t5_h7", "type": "multiple_choice", "instruction": "Cụm 'hot time' được nối âm như thế nào?", "tts_text": "hot time", "options": [ {"id": "A", "text": "ho - time (giữ âm t ở giữa lâu hơn 1 chút)"}, {"id": "B", "text": "hot - t - time (bật 2 lần)"}, {"id": "C", "text": "ho - time (đọc nhanh)"}, {"id": "D", "text": "hot - a - time"} ], "correct_answers": ["A"], "explanation": "Giữ khẩu hình âm t một nhịp rồi bật." },
        { "id": "s5_t5_h8", "type": "multiple_choice", "instruction": "Trong Tiếng Anh-Anh, cụm 'car open' có hiện tượng nối âm gì?", "tts_text": "car open", "options": [ {"id": "A", "text": "Linking R"}, {"id": "B", "text": "Flap T"}, {"id": "C", "text": "Chèn âm /w/"}, {"id": "D", "text": "Bị câm"} ], "correct_answers": ["A"], "explanation": "Âm /r/ xuất hiện để nối: /kɑː - ˈrəʊpən/." },
        { "id": "s5_t5_h9", "type": "multiple_choice", "instruction": "Cụm 'could you' biến âm (Assimilation) thành gì?", "tts_text": "could you", "options": [ {"id": "A", "text": "wu - dʒu (kud-ju)"}, {"id": "B", "text": "wu - du"}, {"id": "C", "text": "would - you"}, {"id": "D", "text": "wu - dzu"} ], "correct_answers": ["A"], "explanation": "d + j -> dʒ." },
        { "id": "s5_t5_h10", "type": "multiple_choice", "instruction": "Cụm 'won't you' biến âm thành gì?", "tts_text": "won't you", "options": [ {"id": "A", "text": "won - tu"}, {"id": "B", "text": "won - tʃu (won-chu)"}, {"id": "C", "text": "won - du"}, {"id": "D", "text": "wont - you"} ], "correct_answers": ["B"], "explanation": "t + j -> tʃ." },
        { "id": "s5_t5_h11", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm (Cần chèn /w/ hoặc /j/) trong câu.", "content": "You are nice.", "tts_text": "You are nice.", "options": [], "correct_answers": ["You are", "youare"], "explanation": "You are -> chèn /w/." },
