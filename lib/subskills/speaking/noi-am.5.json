        { "id": "s5_t5_h13", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm trong câu.", "content": "He ate a lot.", "tts_text": "He ate a lot.", "options": [], "correct_answers": ["He ate", "heate"], "explanation": "He ate -> chèn /j/." },
