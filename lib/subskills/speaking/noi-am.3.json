        { "id": "s5_t3_m20", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "It gives a lot of joy.", "tts_text": "It gives a lot of joy.", "options": [], "correct_answers": ["gives a", "a lot", "lot of", "gives a, a lot, lot of"], "explanation": "gives a, a lot, lot of." },
