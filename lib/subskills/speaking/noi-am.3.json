        { "id": "s5_t3_e1", "type": "multiple_choice", "instruction": "Cụm 'give it' được nối âm như thế nào?", "tts_text": "give it", "options": [ {"id": "A", "text": "gi - vit (gi-vit)"}, {"id": "B", "text": "give - it (không nối)"}, {"id": "C", "text": "gi - ve - it"}, {"id": "D", "text": "giv - it"} ], "correct_answers": ["A"], "explanation": "Chữ 'e' cuối câm, phụ âm /v/ nối với /ɪ/ tạo thành /gɪ - vɪt/." },
        { "id": "s5_t3_e2", "type": "multiple_choice", "instruction": "Cụm 'step up' được nối âm như thế nào?", "tts_text": "step up", "options": [ {"id": "A", "text": "ste - pup (ste-pup)"}, {"id": "B", "text": "step - up"}, {"id": "C", "text": "ste - p - up"}, {"id": "D", "text": "st - epup"} ], "correct_answers": ["A"], "explanation": "Phụ âm /p/ ở cuối nối với nguyên âm /ʌ/ tạo thành /ste - pʌp/." },
        { "id": "s5_t3_e3", "type": "multiple_choice", "instruction": "Cụm 'take it' được nối âm như thế nào?", "tts_text": "take it", "options": [ {"id": "A", "text": "take - it"}, {"id": "B", "text": "ta - kit (ta-kit)"}, {"id": "C", "text": "ta - ke - it"}, {"id": "D", "text": "tak - it"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' cuối 'take' bị câm. Âm thực sự cuối cùng là /k/ nối với /ɪ/ tạo thành /teɪ - kɪt/." },
        { "id": "s5_t3_e4", "type": "multiple_choice", "instruction": "Cụm 'move on' được nối âm như thế nào?", "tts_text": "move on", "options": [ {"id": "A", "text": "move - on"}, {"id": "B", "text": "moo - von (moo-von)"}, {"id": "C", "text": "moov - on"}, {"id": "D", "text": "mo - ve - on"} ], "correct_answers": ["B"], "explanation": "Chữ 'e' ở cuối bị câm, âm /v/ nối với /ɒ/ tạo thành /muː - vɒn/." },
        { "id": "s5_t3_e5", "type": "multiple_choice", "instruction": "Cụm 'put on' được nối âm như thế nào?", "tts_text": "put on", "options": [ {"id": "A", "text": "pu - ton (pu-ton)"}, {"id": "B", "text": "put - on"}, {"id": "C", "text": "pu - t - on"}, {"id": "D", "text": "p - uton"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với âm /ɒ/ tạo thành /pʊ - tɒn/." },
        { "id": "s5_t3_e6", "type": "multiple_choice", "instruction": "Cụm 'come out' được nối âm như thế nào?", "tts_text": "come out", "options": [ {"id": "A", "text": "come - out"}, {"id": "B", "text": "co - mout"}, {"id": "C", "text": "ca - mout (ca-mout)"}, {"id": "D", "text": "co - me - out"} ], "correct_answers": ["C"], "explanation": "Âm /m/ nối với /aʊ/ tạo thành /kʌ - maʊt/." },
        { "id": "s5_t3_e7", "type": "multiple_choice", "instruction": "Cụm 'break it' được nối âm như thế nào?", "tts_text": "break it", "options": [ {"id": "A", "text": "brea - kit (brea-kit)"}, {"id": "B", "text": "break - it"}, {"id": "C", "text": "br - eakit"}, {"id": "D", "text": "brea - k - it"} ], "correct_answers": ["A"], "explanation": "Âm /k/ nối với âm /ɪ/ tạo thành /breɪ - kɪt/." },
        { "id": "s5_t3_e8", "type": "multiple_choice", "instruction": "Cụm 'catch it' được nối âm như thế nào?", "tts_text": "catch it", "options": [ {"id": "A", "text": "catch - it"}, {"id": "B", "text": "ca - tchi - t"}, {"id": "C", "text": "ca - tchit (ca-tchit)"}, {"id": "D", "text": "cat - chit"} ], "correct_answers": ["C"], "explanation": "Âm /tʃ/ nối với /ɪ/ tạo thành /kæ - tʃɪt/." },
        { "id": "s5_t3_e9", "type": "multiple_choice", "instruction": "Cụm 'get up' được nối âm như thế nào?", "tts_text": "get up", "options": [ {"id": "A", "text": "ge - tup (ge-tup)"}, {"id": "B", "text": "get - up"}, {"id": "C", "text": "ge - t - up"}, {"id": "D", "text": "g - etup"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối với /ʌ/ tạo thành /ge - tʌp/." },
        { "id": "s5_t3_e10", "type": "multiple_choice", "instruction": "Cụm 'lock it' được nối âm như thế nào?", "tts_text": "lock it", "options": [ {"id": "A", "text": "lock - it"}, {"id": "B", "text": "lo - c - kit"}, {"id": "C", "text": "lo - ckit (lo-ckit)"}, {"id": "D", "text": "loc - it"} ], "correct_answers": ["C"], "explanation": "Âm /k/ nối với /ɪ/ tạo thành /lɒ - kɪt/." },
