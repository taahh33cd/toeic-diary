    {
      "level": "Medium",
      "exercises": [
        { "id": "s5_t3_m1", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng đuôi '-ed' (được phát âm là /d/) đứng trước một nguyên âm, điều gì xảy ra?", "tts_text": "He played it.", "options": [ {"id": "A", "text": "Âm /d/ bị câm luôn"}, {"id": "B", "text": "Âm /d/ nối liền sang nguyên âm tiếp theo"}, {"id": "C", "text": "Ngắt nghỉ rõ ràng giữa 2 từ"}, {"id": "D", "text": "Đổi thành âm /t/"} ], "correct_answers": ["B"], "explanation": "Ví dụ 'played it' sẽ được đọc là /pleɪ - dɪt/." },
        { "id": "s5_t3_m2", "type": "multiple_choice", "instruction": "Trong câu 'She liked it.', có mấy chỗ nối âm chính?", "tts_text": "She liked it.", "options": [ {"id": "A", "text": "3 chỗ"}, {"id": "B", "text": "1 chỗ"}, {"id": "C", "text": "2 chỗ"}, {"id": "D", "text": "Không có chỗ nào"} ], "correct_answers": ["B"], "explanation": "Có 1 chỗ: liked + it (ed đọc là /t/ nối với i -> /laɪk - tɪt/)." },
        { "id": "s5_t3_m3", "type": "multiple_choice", "instruction": "Cụm 'showed up' nối âm như thế nào?", "tts_text": "showed up", "options": [ {"id": "A", "text": "show - dup"}, {"id": "B", "text": "showed - up"}, {"id": "C", "text": "sho - wedup"}, {"id": "D", "text": "show - e - dup"} ], "correct_answers": ["A"], "explanation": "'showed' có âm cuối là /d/ -> /ʃoʊ - dʌp/." },
        { "id": "s5_t3_m4", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng '-s' (được phát âm là /z/) đứng trước nguyên âm, điều gì xảy ra?", "tts_text": "She has a pen.", "options": [ {"id": "A", "text": "Đổi thành âm /s/"}, {"id": "B", "text": "Bị câm"}, {"id": "C", "text": "Ngắt nghỉ"}, {"id": "D", "text": "Âm /z/ nối liền sang nguyên âm tiếp theo"} ], "correct_answers": ["D"], "explanation": "'has a' đọc là /hæ - zə/." },
        { "id": "s5_t3_m5", "type": "multiple_choice", "instruction": "Cụm 'dogs eat' nối âm như thế nào?", "tts_text": "dogs eat", "options": [ {"id": "A", "text": "dog - seat"}, {"id": "B", "text": "dog - zeat"}, {"id": "C", "text": "dogs - eat"}, {"id": "D", "text": "do - gzeat"} ], "correct_answers": ["B"], "explanation": "'dogs' kết thúc bằng /z/ -> /dɒg - ziːt/." },
        { "id": "s5_t3_m6", "type": "multiple_choice", "instruction": "Trong câu 'He brought an apple.', chỗ nào chứa nối âm?", "tts_text": "He brought an apple.", "options": [ {"id": "A", "text": "brought an"}, {"id": "B", "text": "brought an, an apple"}, {"id": "C", "text": "He brought"}, {"id": "D", "text": "an apple"} ], "correct_answers": ["B"], "explanation": "brought an (/brɔː - tən/), an apple (/ə - næpl/)." },
        { "id": "s5_t3_m7", "type": "multiple_choice", "instruction": "Cụm 'four hours' nối âm như thế nào?", "tts_text": "four hours", "options": [ {"id": "A", "text": "fou - rhours"}, {"id": "B", "text": "four - hours"}, {"id": "C", "text": "fou - rours"}, {"id": "D", "text": "fou - r - hours"} ], "correct_answers": ["C"], "explanation": "Âm /r/ kết nối, h bị câm: /fɔː - raʊəz/." },
        { "id": "s5_t3_m8", "type": "multiple_choice", "instruction": "Trong tiếng Anh-Mỹ, âm /t/ nằm giữa 2 nguyên âm (ví dụ: letter) thường đọc thành gì?", "tts_text": "letter", "options": [ {"id": "A", "text": "Âm /s/"}, {"id": "B", "text": "Âm /d/ (Flap T)"}, {"id": "C", "text": "Âm /k/"}, {"id": "D", "text": "Âm /th/"} ], "correct_answers": ["B"], "explanation": "Flap T." },
        { "id": "s5_t3_m9", "type": "multiple_choice", "instruction": "Cụm 'hit it' trong tiếng Anh-Mỹ thường được đọc là gì do hiện tượng Flap T?", "tts_text": "hit it", "options": [ {"id": "A", "text": "hi - dit"}, {"id": "B", "text": "hi - tit"}, {"id": "C", "text": "hit - it"}, {"id": "D", "text": "hi - sit"} ], "correct_answers": ["A"], "explanation": "Âm /t/ nối sang và biến thành âm /d/ nhẹ: /hɪ - dɪt/." },
        { "id": "s5_t3_m10", "type": "multiple_choice", "instruction": "Cụm 'let out' trong tiếng Anh-Mỹ thường được đọc là gì?", "tts_text": "let out", "options": [ {"id": "A", "text": "le - sout"}, {"id": "B", "text": "le - tout"}, {"id": "C", "text": "le - dout"}, {"id": "D", "text": "let - out"} ], "correct_answers": ["C"], "explanation": "Flap T: /le - daʊt/." },
