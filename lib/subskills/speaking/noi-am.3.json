        { "id": "s5_t3_m16", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "He likes oranges.", "tts_text": "He likes oranges.", "options": [], "correct_answers": ["likes oranges", "likesoranges"], "explanation": "likes (s=s) + oranges." },
        { "id": "s5_t3_m17", "type": "essay_typing", "instruction": "Gõ lại TẤT CẢ các cụm 2 từ có CHỨA NỐI ÂM trong câu sau.", "content": "She needs a book.", "tts_text": "She needs a book.", "options": [], "correct_answers": ["needs a", "needsa"], "explanation": "needs (s=z) + a." },
