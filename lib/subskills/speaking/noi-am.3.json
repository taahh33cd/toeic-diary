      "exercises": [
        { "id": "s5_t3_h1", "type": "multiple_choice", "instruction": "Khi một từ kết thúc bằng Nguyên âm và từ tiếp theo cũng bắt đầu bằng Nguyên âm, người bản xứ thường chèn thêm âm /w/ hoặc /j/ để nối. Khi nào chèn /j/?", "tts_text": "", "options": [ {"id": "A", "text": "Khi từ đầu kết thúc bằng âm chu môi (o, u, oo)"}, {"id": "B", "text": "Khi từ đầu kết thúc bằng âm bè ngang (i, e, ei)"}, {"id": "C", "text": "Luôn luôn chèn /j/"}, {"id": "D", "text": "Tùy hứng"} ], "correct_answers": ["B"], "explanation": "Khẩu hình bè ngang chuyển sang mở miệng sinh ra /j/." },
        { "id": "s5_t3_h2", "type": "multiple_choice", "instruction": "Cụm 'do apples' được chèn thêm âm gì để nối?", "tts_text": "do apples", "options": [ {"id": "A", "text": "Âm /w/ (do - w - apples)"}, {"id": "B", "text": "Âm /j/ (do - y - apples)"}, {"id": "C", "text": "Âm /r/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["A"], "explanation": "do kết thúc bằng /uː/ chu môi -> chèn /w/." },
        { "id": "s5_t3_h3", "type": "multiple_choice", "instruction": "Cụm 'we are' được chèn thêm âm gì để nối?", "tts_text": "we are", "options": [ {"id": "A", "text": "Âm /j/ (we - y - are)"}, {"id": "B", "text": "Âm /w/ (we - w - are)"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /d/"} ], "correct_answers": ["A"], "explanation": "we kết thúc bằng /iː/ -> chèn /j/." },
        { "id": "s5_t3_h4", "type": "multiple_choice", "instruction": "Cụm 'so I' được chèn thêm âm gì để nối?", "tts_text": "so I", "options": [ {"id": "A", "text": "Âm /j/"}, {"id": "B", "text": "Âm /w/ (so - w - I)"}, {"id": "C", "text": "Âm /h/"}, {"id": "D", "text": "Âm /s/"} ], "correct_answers": ["B"], "explanation": "so kết thúc bằng /oʊ/ chu môi -> chèn /w/." },
        { "id": "s5_t3_h5", "type": "multiple_choice", "instruction": "Cụm 'they are' được chèn thêm âm gì để nối?", "tts_text": "they are", "options": [ {"id": "A", "text": "Âm /w/"}, {"id": "B", "text": "Âm /j/ (they - y - are)"}, {"id": "C", "text": "Âm /t/"}, {"id": "D", "text": "Âm /h/"} ], "correct_answers": ["B"], "explanation": "they kết thúc bằng /eɪ/ -> chèn /j/." },
        { "id": "s5_t3_h6", "type": "multiple_choice", "instruction": "Khi từ kết thúc bằng một Phụ âm và từ sau bắt đầu bằng CHÍNH PHỤ ÂM ĐÓ (Geminates), ta nên đọc thế nào?", "tts_text": "bad day", "options": [ {"id": "A", "text": "Bị câm hoàn toàn"}, {"id": "B", "text": "Đọc thành một phụ âm khác"}, {"id": "C", "text": "Giữ khẩu hình phụ âm đó lâu hơn một chút (Chỉ bật 1 lần)"}, {"id": "D", "text": "Đọc tách rời, bật 2 lần" } ], "correct_answers": ["C"], "explanation": "Geminates." },
        { "id": "s5_t3_h7", "type": "multiple_choice", "instruction": "Cụm 'big game' được nối âm như thế nào?", "tts_text": "big game", "options": [ {"id": "A", "text": "bi - game (giữ âm g ở giữa lâu hơn 1 chút)"}, {"id": "B", "text": "big - g - game (bật 2 lần)"}, {"id": "C", "text": "bi - game (đọc nhanh)"}, {"id": "D", "text": "big - a - game"} ], "correct_answers": ["A"], "explanation": "Giữ khẩu hình âm g một nhịp rồi bật." },
        { "id": "s5_t3_h8", "type": "multiple_choice", "instruction": "Trong Tiếng Anh-Anh, cụm 'more ice' có hiện tượng nối âm gì?", "tts_text": "more ice", "options": [ {"id": "A", "text": "Linking R"}, {"id": "B", "text": "Flap T"}, {"id": "C", "text": "Chèn âm /w/"}, {"id": "D", "text": "Bị câm"} ], "correct_answers": ["A"], "explanation": "Âm /r/ xuất hiện để nối: /mɔː - raɪs/." },
        { "id": "s5_t3_h9", "type": "multiple_choice", "instruction": "Cụm 'would you' biến âm (Assimilation) thành gì?", "tts_text": "would you", "options": [ {"id": "A", "text": "wu - dʒu (kud-ju)"}, {"id": "B", "text": "wu - du"}, {"id": "C", "text": "would - you"}, {"id": "D", "text": "wu - dzu"} ], "correct_answers": ["A"], "explanation": "d + j -> dʒ." },
        { "id": "s5_t3_h10", "type": "multiple_choice", "instruction": "Cụm 'won't you' biến âm thành gì?", "tts_text": "won't you", "options": [ {"id": "A", "text": "won - tu"}, {"id": "B", "text": "won - tʃu (won-chu)"}, {"id": "C", "text": "won - du"}, {"id": "D", "text": "wont - you"} ], "correct_answers": ["B"], "explanation": "t + j -> tʃ." },
        { "id": "s5_t3_h11", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm (Cần chèn /w/ hoặc /j/) trong câu.", "content": "You and I.", "tts_text": "You and I.", "options": [], "correct_answers": ["You and", "youand"], "explanation": "You and -> chèn /w/." },
        { "id": "s5_t3_h12", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm trong câu.", "content": "I answered it.", "tts_text": "I answered it.", "options": [], "correct_answers": ["I answered", "ianswered"], "explanation": "I answered -> chèn /j/." },
        { "id": "s5_t3_h13", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm trong câu.", "content": "He asked a question.", "tts_text": "He asked a question.", "options": [], "correct_answers": ["He asked", "heasked"], "explanation": "He asked -> chèn /j/." },
        { "id": "s5_t3_h14", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm trong câu.", "content": "Go out now.", "tts_text": "Go out now.", "options": [], "correct_answers": ["Go out", "goout"], "explanation": "Go out -> chèn /w/." },
        { "id": "s5_t3_h15", "type": "essay_typing", "instruction": "Tìm và gõ lại cụm Nguyên âm + Nguyên âm trong câu.", "content": "Two apples.", "tts_text": "Two apples.", "options": [], "correct_answers": ["Two apples", "twoapples"], "explanation": "Two apples -> chèn /w/." },
        { "id": "s5_t3_h16", "type": "essay_typing", "instruction": "Tìm cụm có phụ âm trùng lặp (Giữ khẩu hình 1 nhịp - Phụ âm đôi) trong câu.", "content": "It is a red door.", "tts_text": "It is a red door.", "options": [], "correct_answers": ["red door", "reddoor"], "explanation": "red kết thúc d, door bắt đầu d." },
        { "id": "s5_t3_h17", "type": "essay_typing", "instruction": "Tìm cụm có phụ âm trùng lặp trong câu.", "content": "He has some cold days.", "tts_text": "He has some cold days.", "options": [], "correct_answers": ["cold days", "colddays"], "explanation": "cold kết thúc d, days bắt đầu d." },
        { "id": "s5_t3_h18", "type": "essay_typing", "instruction": "Tìm cụm có phụ âm trùng lặp trong câu.", "content": "I like dark clouds.", "tts_text": "I like dark clouds.", "options": [], "correct_answers": ["dark clouds", "darkclouds"], "explanation": "dark kết thúc k, clouds bắt đầu k (âm c đọc là k)." },
